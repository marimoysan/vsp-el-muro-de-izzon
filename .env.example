# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local.
# En Vercel: Project Settings → Environment Variables.

# Service account de Google Cloud (APIs de Drive y Sheets habilitadas)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
# Clave privada en una sola línea, con los saltos de línea como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID de la carpeta de Drive (dentro de una Unidad compartida) donde van las fotos
GOOGLE_DRIVE_FOLDER_ID=

# ID de la hoja de cálculo y rango donde se añaden las respuestas (Equipo | Respuesta)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Respuestas!A:B
